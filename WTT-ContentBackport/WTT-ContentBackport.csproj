<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WTTContentBackport</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.0.1</Version>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)-$(Version)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.1" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.1" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.1" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.1" />
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.2" />
  </ItemGroup>
	
	
	<PropertyGroup>
		<TarkovDir Condition=" '$(TarkovDir)' == '' ">$(SolutionDir)..\..\</TarkovDir>

		<!-- Live SPT Runtime deployment -->
		<SptModDir>$(TarkovDir)SPT_Runtime\user\mods\WTT-ContentBackport</SptModDir>

		<!-- Clean, package-ready mod staging directory -->
		<BuildModDir>$(ProjectDir)..\Build\SPT_Runtime\user\mods\WTT-ContentBackport</BuildModDir>
	</PropertyGroup>

	<!-- Gets the commit hash from git -->
	<Target Name="SetSourceRevisionId" BeforeTargets="InitializeSourceControlInformation">
		<Exec Command="git describe --long --always --dirty --exclude=* --abbrev=8"
			  ConsoleToMSBuild="True"
			  IgnoreExitCode="False">
			<Output PropertyName="SourceRevisionId" TaskParameter="ConsoleOutput" />
		</Exec>
	</Target>

	<Target Name="CopyToServer" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<OutputDLL Include="$(TargetPath)" />
			<Resources Include="$(ProjectDir)Resources\**\*.*" />
		</ItemGroup>

		<!-- Copies the output DLL into the local SPT Runtime mod folder -->
		<MakeDir Directories="$(SptModDir)" />
		<Copy SourceFiles="@(OutputDLL)"
			  DestinationFolder="$(SptModDir)"
			  SkipUnchangedFiles="true" />

		<!-- Copies resources into the local SPT Runtime mod folder -->
		<Copy SourceFiles="@(Resources)"
			  DestinationFolder="$(SptModDir)\%(RecursiveDir)"
			  SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopyToBuildDirectory" AfterTargets="PostBuildEvent">
		<ItemGroup>
			<BuildOutputDLL Include="$(TargetPath)" />
			<BuildResources Include="$(ProjectDir)Resources\**\*.*" />
		</ItemGroup>

		<!-- Prevent stale files from ending up in the zip/package -->
		<RemoveDir Directories="$(BuildModDir)" Condition="Exists('$(BuildModDir)')" />
		<MakeDir Directories="$(BuildModDir)" />

		<!-- Copy plugin DLL to package staging folder -->
		<Copy SourceFiles="@(BuildOutputDLL)"
			  DestinationFolder="$(BuildModDir)"
			  SkipUnchangedFiles="true" />

		<!-- Preserve the Resources directory structure in package staging -->
		<Copy SourceFiles="@(BuildResources)"
			  DestinationFolder="$(BuildModDir)\%(RecursiveDir)"
			  SkipUnchangedFiles="true" />

		<Message Importance="high"
				 Text="[PostBuild] Package-ready mod output: $(BuildModDir)" />
	</Target>
</Project>
